{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.EventLog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ajazz-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Ajazz": {
    "WebHost": "http://127.0.0.1:5588",
    "SelectedDevicePath": "",
    "SyncIntervalHours": 1,
    "BatteryPollIntervalSeconds": 5,
    "SyncIntervalEnabled": true,
    "SyncOnStartup": true,
    "SyncOnDeviceConnect": true,
    "LastCustomDateTime": "9999-09-09T00:00",
    "DebugLogging": {
      "Enabled": true,
      "LogFilePath": "logs/ajazz-hid-usb.log",
      "VendorId": "0x3151",
      "ProductIds": [
        "0x5007",
        "0x4026"
      ]
    }
  }
}

